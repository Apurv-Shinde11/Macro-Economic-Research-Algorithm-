{
    "version": 2,
    "outputDirectory": ".",
    "builds": [
        {
            "src": "landing_page.html",
            "use": "@vercel/static"
        },
        {
            "src": "login.html",
            "use": "@vercel/static"
        },
        {
            "src": "dashboard.html",
            "use": "@vercel/static"
        },
        {
            "src": "global_macro.html",
            "use": "@vercel/static"
        },
        {
            "src": "pe.html",
            "use": "@vercel/static"
        },
        {
            "src": "simulator.html",
            "use": "@vercel/static"
        },
        {
            "src": "admin.html",
            "use": "@vercel/static"
        },
        {
            "src": "portfolio.html",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/",
            "dest": "/landing_page.html"
        },
        {
            "src": "/login",
            "dest": "/login.html"
        },
        {
            "src": "/dashboard",
            "dest": "/dashboard.html"
        },
        {
            "src": "/global-macro",
            "dest": "/global_macro.html"
        },
        {
            "src": "/pe",
            "dest": "/pe.html"
        },
        {
            "src": "/simulator",
            "dest": "/simulator.html"
        },
        {
            "src": "/admin",
            "dest": "/admin.html"
        },
        {
            "src": "/portfolio",
            "dest": "/portfolio.html"
        },
        {
            "src": "/(.*\\.html)",
            "dest": "/$1"
        }
    ]
}